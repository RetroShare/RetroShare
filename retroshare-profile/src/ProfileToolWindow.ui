      <item>
       <widget class="QLabel" name="portableLabel">
        <property name="text">
         <string>&lt;b&gt;Using a portable RetroShare?&lt;/b&gt; Its nodes are stored in its own folder, not in the standard folder shown here. Choose the portable RetroShare folder to see them.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="choosePortableButton">
        <property name="toolTip">
         <string>Choose the folder of your portable RetroShare (the one containing retroshare.exe and the "portable" file)</string>
        </property>
        <property name="text">
         <string>Choose portable folder...</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="contentHLayout">
