#ifndef RSGUI_RSGUIVERSION_H
#define RSGUI_RSGUIVERSION_H

${DEFINE_RSGUI_VERSION}
${DEFINE_RSGUI_VERSION_FULL}
${DEFINE_RSGUI_VERSION_PUBLIC}
${DEFINE_RSGUI_VERSION_MAJOR}
${DEFINE_RSGUI_VERSION_MINOR}
${DEFINE_RSGUI_VERSION_PATCH}
${DEFINE_RSGUI_VERSION_TWEAK}
${DEFINE_RSGUI_VERSION_NUMERIC}

#define RSGUI_VERSION_ATLEAST(MAJOR, MINOR, PATCH, TWEAK) (\
	${version_numeric2} >= \
	((MAJOR) << 24 | (MINOR) << 16 | (PATCH) << 8 | (TWEAK) << 0) \
)


// deprecated

#endif // RSGUI_RSGUIVERSION_H
