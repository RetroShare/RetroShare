<ui version="4.0">
 <class>ProfileUpgradeDialog</class>
 <widget class="QDialog" name="ProfileUpgradeDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>560</width>
    <height>520</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Upgrade node</string>
  </property>
  <layout class="QVBoxLayout" name="mainVLayout">
   <item>
    <widget class="QLabel" name="infoLabel">
     <property name="text">
      <string>&lt;p&gt;Creates a &lt;b&gt;new node&lt;/b&gt; of the same profile with new, strong SSL keys and moves everything of the selected node to it: friends, settings, identities, forums, channels, messages, chat history and the Tor hidden service.&lt;/p&gt;&lt;p&gt;Use it when your node is too old for the OpenSSL version of this RetroShare. Your PGP key does not change. The new node gets a new node ID: outgoing connections work right away, and for incoming connections send your new certificate to your friends.&lt;/p&gt;&lt;p&gt;The old node is not modified and is not deleted.&lt;/p&gt;</string>
     </property>
     <property name="textFormat">
      <enum>Qt::RichText</enum>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QFormLayout" name="formLayout">
     <item row="0" column="0">
      <widget class="QLabel" name="nodeTitleLabel">
       <property name="text">
        <string>Node:</string>
       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QLabel" name="nodeLabel">
       <property name="textInteractionFlags">
        <set>Qt::TextSelectableByMouse</set>
       </property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QLabel" name="passwordTitleLabel">
       <property name="text">
        <string>Password:</string>
       </property>
       <property name="buddy">
