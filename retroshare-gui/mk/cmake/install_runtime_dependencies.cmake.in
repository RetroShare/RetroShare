# 3.15: file(INSTALL FOLLOW_SYMLINK_CHAIN)
# 3.16: file(GET_RUNTIME_DEPENDENCIES)
cmake_minimum_required(VERSION 3.16...4.4)

set(RUNTIME_DEPENDENCY_EXECUTABLES [===[@RUNTIME_DEPENDENCY_EXECUTABLES@]===])
set(RUNTIME_DEPENDENCY_LIBRARIES   [===[@RUNTIME_DEPENDENCY_LIBRARIES@]===])
set(RUNTIME_DEPENDENCY_MODULES     [===[@RUNTIME_DEPENDENCY_MODULES@]===])
set(RUNTIME_DEPENDENCY_DIRECTORIES [===[@RUNTIME_DEPENDENCY_DIRECTORIES@]===])
set(RUNTIME_DEPENDENCY_DESTINATION [===[@RUNTIME_DEPENDENCY_DESTINATION@]===])

if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.20)
	cmake_path(ABSOLUTE_PATH RUNTIME_DEPENDENCY_DESTINATION
		BASE_DIRECTORY ${CMAKE_INSTALL_PREFIX}
	)
else()
	get_filename_component(RUNTIME_DEPENDENCY_DESTINATION
		${RUNTIME_DEPENDENCY_DESTINATION}
		ABSOLUTE
		BASE_DIR ${CMAKE_INSTALL_PREFIX}
	)
endif()

if([===[@MINGW@]===] AND [===[@CMAKE_CROSSCOMPILING@]===])
	set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "windows+pe")
	set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL "objdump")
	set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND [===[@CMAKE_OBJDUMP@]===])
endif()

file(GET_RUNTIME_DEPENDENCIES
	RESOLVED_DEPENDENCIES_VAR RUNTIME_DEPENDENCIES_RESOLVED
	UNRESOLVED_DEPENDENCIES_VAR RUNTIME_DEPENDENCIES_UNRESOLVED
	CONFLICTING_DEPENDENCIES_PREFIX RUNTIME_DEPENDENCIES_CONFLICT
	EXECUTABLES ${RUNTIME_DEPENDENCY_EXECUTABLES}
	LIBRARIES ${RUNTIME_DEPENDENCY_LIBRARIES}
	MODULES ${RUNTIME_DEPENDENCY_MODULES}
	DIRECTORIES ${RUNTIME_DEPENDENCY_DIRECTORIES}
	PRE_EXCLUDE_REGEXES
		"^advapi32\\.dll\$"
		"^aleaut32\\.dll\$"
		"^api-ms-win-.*\\.dll\$"
		"^authz\\.dll\$"
		"^avrt\\.dll\$"
		"^comdlg32\\.dll\$"
		"^crypt32\\.dll\$"
		"^d3d11\\.dll\$"
		"^d3d12\\.dll\$"
		"^dnsapi\\.dll\$"
		"^dwmapi\\.dll\$"
		"^dwrite\\.dll\$"
		"^dxgi\\.dll\$"
		"^gdi32\\.dll\$"
		"^kernel32\\.dll\$"
		"^iphlpapi\\.dll\$"
		"^mpr\\.dll\$"
		"^netapi32\\.dll\$"
		"^ntdll\\.dll\$"
		"^ole32\\.dll\$"
		"^oleaut32\\.dll\$"
		"^propsys\\.dll\$"
		"^shell32\\.dll\$"
		"^secur32\\.dll\$"
		"^user32\\.dll\$"
		"^userenv\\.dll\$"
		"^uxtheme\\.dll\$"
		"^version\\.dll\$"
		"^winhttp\\.dll\$"
		"^winmm\\.dll\$"
		"^ws2_32\\.dll\$"
)

if(RUNTIME_DEPENDENCIES_UNRESOLVED)
	message(FATAL_ERROR
		"unresolved runtime dependencies: ${RUNTIME_DEPENDENCIES_UNRESOLVED}\n"
	)
endif()

foreach(conflict ${RUNTIME_DEPENDENCIES_CONFLICT_FILENAMES})
	set(files ${RUNTIME_DEPENDENCIES_CONFLICT_${conflict}})
	message(WARNING
		"conflicting runtime dependencies: ${files}"
	)
	list(GET files 0 first)
	list(APPEND RUNTIME_DEPENDENCIES_RESOLVED ${first})
endforeach()

file(INSTALL ${RUNTIME_DEPENDENCIES_RESOLVED}
	DESTINATION ${RUNTIME_DEPENDENCY_DESTINATION}
	FOLLOW_SYMLINK_CHAIN
)
