     <widget class="QWidget" name="qwpIntro">
      <property name="pageTitle" stdset="0">
       <string>Introduction</string>
      </property>
      <property name="pageSubTitle" stdset="0">
       <string>Welcome to the RetroShare audio and video wizard</string>
      </property>
      <layout class="QVBoxLayout" name="qvlIntro">
       <item>
        <widget class="QLabel" name="qlIntro">
         <property name="text">
          <string>&lt;p&gt;This wizard helps you to set up voice and video calls:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;choose the &lt;b&gt;microphone&lt;/b&gt; and the &lt;b&gt;speakers / headphones&lt;/b&gt; to use,&lt;/li&gt;&lt;li&gt;adjust the microphone level and the voice detection,&lt;/li&gt;&lt;li&gt;choose your &lt;b&gt;camera&lt;/b&gt; and check the picture.&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;While the wizard is open your microphone may be played back to you locally, so that you can hear yourself. Nothing is sent to your friends.&lt;/p&gt;&lt;p&gt;You can cancel the wizard at any time: your previous settings will then be restored.&lt;/p&gt;</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="qsIntro">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
